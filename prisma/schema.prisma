// ============================================================================
// CARE System - Corporate Operational Car Booking System (Workplace Solution)
// Prisma schema for PostgreSQL (Neon / Vercel Postgres / Supabase)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  employeeNo     String    @unique
  email          String    @unique
  passwordHash   String
  name           String
  department     String
  phone          String
  role           String    @default("EMPLOYEE") // EMPLOYEE, DRIVER, WORKPLACE_ADMIN, SUPER_ADMIN
  status         String    @default("PENDING_APPROVAL") // PENDING_APPROVAL, ACTIVE, DEACTIVATED, REJECTED
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  gpsConsent     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  driverProfile Driver?
  notifications Notification[]

  @@index([status])
  @@index([phone])
}

model CarType {
  id             String    @id @default(cuid())
  name           String    @unique
  code           String    @unique
  powertrain     String // EV | PETROL | HYBRID
  seats          Int
  defaultRangeKm Int
  description    String
  badgeText      String
  iconType       String // EV | MPV | SEDAN | VAN
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  vehicles       Vehicle[]
}

model Vehicle {
  id            String   @id @default(cuid())
  plateNo       String   @unique
  model         String
  carTypeId     String
  carType       CarType  @relation(fields: [carTypeId], references: [id])
  powertrain    String // EV | PETROL
  seats         Int
  usableRangeKm Int
  odometerKm    Int
  currentLevel  Int      @default(100) // % battery charge or fuel
  needsRefuel   Boolean  @default(false)
  status        String   @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE, OUT_OF_SERVICE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  maintenanceBlocks MaintenanceBlock[]
}

model Driver {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  licenseNo String
  deviceId  String
  status    String @default("AVAILABLE") // AVAILABLE, ON_TRIP, OFF_DUTY
}

model Booking {
  id                   String    @id @default(cuid())
  bookingNo            String    @unique
  requesterId          String
  // Snapshot of requester details at the time of booking (kept for reports)
  requesterName        String
  requesterDepartment  String
  requesterPhone       String
  startAt              DateTime
  endAt                DateTime
  pickupLocation       String
  destination          String
  purpose              String
  passengers           Int
  estDistanceKm        Int
  preferredCarTypeId   String?
  preferredCarTypeName String?
  preferredPowertrain  String    @default("ANY") // EV, PETROL, ANY
  channel              String    @default("APP") // APP, WHATSAPP
  status               String    @default("PENDING_APPROVAL")
  vehicleId            String?
  vehiclePlate         String?
  vehicleModel         String?
  vehiclePowertrain    String?
  driverId             String?
  driverName           String?
  driverPhone          String?
  decidedById          String?
  decidedByName        String?
  decidedAt            DateTime?
  decisionNote         String?
  lateCancelFlag       Boolean   @default(false)
  overrideFlag         Boolean   @default(false)
  evRangeWarning       Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  history BookingStatusHistory[]
  trip    Trip?

  @@index([status, startAt])
  @@index([requesterId])
  @@index([vehicleId, status])
  @@index([driverId, status])
}

model BookingStatusHistory {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  actorId    String
  actorName  String
  reason     String?
  at         DateTime @default(now())

  @@index([bookingId])
}

model Trip {
  id               String     @id @default(cuid())
  bookingId        String     @unique
  booking          Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  checkoutAt       DateTime?
  checkinAt        DateTime?
  odoStart         Int?
  odoEnd           Int?
  distanceKm       Int?
  levelStart       Int?
  levelEnd         Int?
  actualUsers      String[]
  actualUserIds    String[]
  requesterMatched Boolean    @default(true)
  incidentNote     String?
  lateReturn       Boolean    @default(false)
  lowFuelFlag      Boolean    @default(false)
  gpsLostFlag      Boolean    @default(false)
  gpsPoints        GpsPoint[]
}

model GpsPoint {
  id         String   @id @default(cuid())
  tripId     String
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat        Float
  lng        Float
  label      String
  speedKmh   Float?
  recordedAt DateTime @default(now())

  @@index([tripId, recordedAt])
}

model MaintenanceBlock {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  startAt   DateTime
  endAt     DateTime
  reason    String
  createdBy String
  createdAt DateTime @default(now())

  @@index([vehicleId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  event     String
  title     String
  message   String
  bookingId String?
  channel   String   @default("APP")
  status    String   @default("SENT")
  read      Boolean  @default(false)
  sentAt    DateTime @default(now())

  @@index([userId, sentAt])
}

// Append-only: the application never updates or deletes rows in this table.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  actorRole String
  action    String
  entity    String
  entityId  String
  summary   String
  before    String?
  after     String?
  at        DateTime @default(now())

  @@index([at])
}

// Single row (id = "global") holding business-rule settings as JSON
model Setting {
  id        String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model WhatsAppSession {
  phone          String   @id
  data           Json
  lastActivityAt DateTime @default(now())
}

model RateLimit {
  key         String    @id
  count       Int
  resetAt     DateTime
  lockedUntil DateTime?
}
