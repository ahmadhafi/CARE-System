# ============================================================================
# CARE System (Workplace Solution) - Environment Variables Template
# Copy this file to .env.local for local development or configure in Vercel
# NEVER use NEXT_PUBLIC_ for any secret, password, or API key!
# ============================================================================

# 1. Server-Only JWT Session Signing Key (REQUIRED in Production, Min 32 chars)
# Generate one via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-64-char-cryptographically-secure-random-hex-key"

# 2. PostgreSQL Connection URLs (Vercel Postgres / Neon / Supabase)
# Pooled connection string (used by Prisma Client at runtime)
DATABASE_URL="postgresql://user:password@host:5432/care_system?pgbouncer=true&connect_timeout=15"
# Direct / Unpooled connection string (used by Prisma schema push & migrations)
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/care_system"

# 3. Initial Seed Account Passwords (Server-Only - Used only when seeding an empty DB)
# Set strong passwords before first run. If omitted locally, a random one-time
# session password is generated and printed only to the local server console.
INITIAL_ADMIN_PASSWORD="replace-with-strong-workplace-admin-password"
INITIAL_SUPER_ADMIN_PASSWORD="replace-with-strong-super-admin-password"
INITIAL_EMPLOYEE_PASSWORD="replace-with-strong-employee-password"
INITIAL_DRIVER_PASSWORD="replace-with-strong-driver-password"

# 4. Session Idle Timeout in Minutes (PRD NFR-004: 30 minutes)
SESSION_TIMEOUT_MINUTES="30"

# 5. Internal WhatsApp Business Webhook Verification Secret (Server-Only)
WHATSAPP_WEBHOOK_SECRET="replace-with-internal-whatsapp-webhook-secret"
