# ============================================================================
# CARE System (Workplace Solution) - Environment Variables Template
# Copy this file to .env.local for local development or configure in Vercel
# NEVER use NEXT_PUBLIC_ for any secret or API key!
# ============================================================================

# Server-Only JWT Session Signing Key (Minimum 32 characters random string)
# Generate one via: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-64-char-cryptographically-secure-random-hex-key"

# Optional PostgreSQL Connection URL (Vercel Postgres / Neon / Supabase)
# If omitted locally, the system uses its encrypted/validated persistent seed store
DATABASE_URL="postgresql://user:password@localhost:5432/care_system?schema=public"

# Session Idle Timeout in Minutes (PRD NFR-004: 30 minutes)
SESSION_TIMEOUT_MINUTES="30"

# Internal WhatsApp Business Webhook Verification Secret (Server-Only)
WHATSAPP_WEBHOOK_SECRET="replace-with-internal-whatsapp-webhook-secret"
